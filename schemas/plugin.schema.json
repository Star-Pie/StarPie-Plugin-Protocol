{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starpie.org/schemas/community/plugin.schema.json",
  "title": "StarPie Community Plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "publisherId",
    "name",
    "description",
    "repository",
    "homepage",
    "license",
    "categories",
    "paths",
    "declaredCapabilities",
    "channels",
    "status",
    "replacedBy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^io\\.github\\.[a-z0-9-]+(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "publisherId": {
      "type": "string",
      "pattern": "^github:[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "action-execution",
          "interaction-event",
          "wheel-structure"
        ]
      }
    },
    "declaredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable",
        "beta"
      ],
      "properties": {
        "stable": {
          "type": [
            "string",
            "null"
          ]
        },
        "beta": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "blocked"
      ]
    },
    "replacedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
