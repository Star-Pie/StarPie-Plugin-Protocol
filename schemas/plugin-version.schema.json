{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starpie.org/schemas/community/plugin-version.schema.json",
  "title": "StarPie Community Plugin Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "version",
    "channel",
    "publishedAt",
    "source",
    "compatibility",
    "asset",
    "capabilities",
    "status",
    "reason",
    "replacedBy",
    "advisory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "minimumHostVersion",
        "maximumHostVersion",
        "targetFramework",
        "platform"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "minimumHostVersion": {
          "type": "string",
          "minLength": 1
        },
        "maximumHostVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetFramework": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "const": "win-x64"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "downloadUrl",
        "sha256",
        "size"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "\\.spkg$"
        },
        "downloadUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/]+\\.spkg$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "active",
        "yanked",
        "revoked"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "replacedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "advisory": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
