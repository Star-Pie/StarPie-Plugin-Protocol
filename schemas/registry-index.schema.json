{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starpie.org/schemas/community/registry-index.schema.json",
  "title": "StarPie Community Registry Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalog",
    "sourceDigest",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalog": {
      "const": "generated/community-catalog.json"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "pattern": "^plugins/.+/plugin\\.json$"
          }
        }
      }
    }
  }
}
